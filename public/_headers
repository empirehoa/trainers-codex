# Cloudflare Pages security headers for Trainer's Codex.
# Drop this into the deploy root. Cloudflare reads it automatically.
# Documented at: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Content-Security-Policy
  #
  # The bundle inlines all of its JS and CSS into a single HTML — that's the
  # whole product identity. We allow 'unsafe-inline' for script-src and style-src
  # because of that. The trade-off is documented in docs/SECURITY.md.
  #
  # Network endpoints we actually call:
  #   - https://esm.sh                — Supabase JS client (when auth configured)
  #   - https://*.supabase.co         — auth + cloud-sync (when configured)
  #   - https://api.pokemontcg.io     — TCG card lookups
  #   - https://images.pokemontcg.io  — TCG card art
  #   - https://raw.githubusercontent.com — PokeAPI sprite mirror
  #   - https://api.printful.com      — POD fulfillment (server-side only — never browser)
  #   - https://api.stripe.com / checkout.stripe.com — Stripe Checkout redirects
  #   - https://js.stripe.com         — Stripe.js (only if loaded — currently unused, redirect-based)
  #   - https://plausible.io          — analytics (optional)
#   - https://pokepast.es / pokebin.com / teams.pokemonshowdown.com — Showdown paste-link
#       import ("Fetch & import" in the import dialog, src/lib/paste-url.ts). Without
#       these in connect-src the fetch is CSP-blocked on the live origin and the
#       feature silently degrades to "open the link and copy the text".
#   - https://static.cloudflareinsights.com / https://cloudflareinsights.com —
#       Cloudflare Web Analytics beacon. Cloudflare auto-injects it at the edge
#       for the zone; it is cookieless and stores no per-user identifier. Listing
#       it stops the console error on every page load. The owner may instead
#       disable Web Analytics for the zone in the Cloudflare dashboard, in which
#       case both hosts can be dropped again.
  #   - blob: in script-src — the lazily loaded @smogon/calc chunk ships inside
  #       bundle.html as an inert text block and is imported as a Blob-URL module
  #       on first matchup (inline.mjs). Without blob: the matchup preview never
  #       loads on the live origin; it is not a network source.
  #   - https://trainers-codex-api.jrriestra.workers.dev — API Worker (Stripe Checkout session,
  #       license verify, Printful submit). REQUIRED in connect-src or the browser blocks the
  #       checkout fetch and no purchase can complete. api.trainerscodex.com is the future alias.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://esm.sh https://js.stripe.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://raw.githubusercontent.com https://images.pokemontcg.io https://*.supabase.co https://avatars.githubusercontent.com https://lh3.googleusercontent.com https://cdn.discordapp.com https://platform-lookaside.fbsbx.com; connect-src 'self' https://esm.sh https://*.supabase.co https://api.pokemontcg.io https://raw.githubusercontent.com https://api.stripe.com https://checkout.stripe.com https://plausible.io https://trainers-codex-api.jrriestra.workers.dev https://api.trainerscodex.com https://pokepast.es https://pokebin.com https://teams.pokemonshowdown.com https://cloudflareinsights.com; frame-src https://checkout.stripe.com https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests
  # Click-jacking protection (belt + suspenders with frame-ancestors above).
  X-Frame-Options: DENY
  # Block MIME-sniffing so a .png can't be served as text/html.
  X-Content-Type-Options: nosniff
  # Force HTTPS for two years across all subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Don't leak the full URL to third parties.
  Referrer-Policy: strict-origin-when-cross-origin
  # Strip permissions for sensors we never use.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self "https://checkout.stripe.com"), usb=()
  # Cross-origin isolation (defensive — useful if we add SharedArrayBuffer later).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Long cache for the print-ready PNGs and static assets.
/*.png
  Cache-Control: public, max-age=604800, immutable
/*.svg
  Cache-Control: public, max-age=604800, immutable

# Don't cache the HTML so deploys roll forward immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Static reference pages (scripts/gen-seo-pages.ts). These change only when the
# Pokemon dataset does, so an hour at the edge with a day of stale-while-
# revalidate keeps them fast for crawlers without pinning a wrong page after a
# data update.
/pokemon/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/type/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# PWA service worker: never long-cache, or clients get stuck on a stale SW and
# never pick up a new shell. Browsers revalidate the SW script on every update
# check; this keeps the HTTP layer from getting in the way.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Manifest: pin the MIME type (some hosts serve .webmanifest as octet-stream,
# which browsers reject) and keep it fresh so install metadata updates promptly.
/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8
